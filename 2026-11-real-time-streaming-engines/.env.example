# Copy to .env and edit. Plain KEY=value lines, no quotes and no trailing comments.
# Variables already set in the environment take precedence over this file, so a command
# run on another host can override any value, for example:
#   ssh producer env QDB_ADDR=10.0.0.5:9000 bench/aws/run.sh ...

# QuestDB host:port, as seen from where the scripts run. QWP ingestion and the REST API
# share it (port 9000 by default).
QDB_ADDR=localhost:9000
# Optional: REST base URL when it differs from http://QDB_ADDR
# QDB_HTTP=http://localhost:9000

# Run knobs for aws/run.sh and aws/sweep.sh
RATE=50000
DEDUP=SKIP
RUN_SECONDS=30
# Optional: enables client store-and-forward in aws/run.sh (absolute path, must exist)
# SF_DIR=/home/ubuntu/sf

# aws/matrix.py (runs scenarios from your machine over ssh)
# SSH_KEY=/path/to/key.pem
# SSH_USER=ubuntu
# SERVER_HOST=<server public address>
# PRODUCER_HOST=<producer public address>
# KAFKA_HOST=<kafka broker public address>
# SERVER_PRIVATE=<server private address>
# KAFKA_PRIVATE=<kafka broker private address>
# SF_DIR=/home/ubuntu/sf
# SERVER_CONF=pools_nap.conf

# Server host settings (aws/server_setup.sh, aws/start_qdb.sh, cpusample.py)
QDB_VERSION=10.2.0
QDB_HOME=/opt/questdb
QDB_ROOT=/data/qdb
DATA_MOUNT=/data
DATA_DEV_SIZE=200G
# CPUs QuestDB is pinned to with taskset; empty = no pinning. 1-7 on an 8 vCPU host
# leaves vCPU 0 for the OS and matches a 7 core budget.
QDB_CPUS=
